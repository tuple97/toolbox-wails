{
  "name": "toolbox-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:app": "cd .. && set \"FRONTEND_DEVSERVER_URL=http://127.0.0.1:5173\" && go run .",
    "build": "vue-tsc --noEmit && vite build",
    "build:app": "pnpm gen:icon && pnpm build && cd .. && go build -tags production -ldflags \"-w -s -H=windowsgui\" -o build/bin/toolbox.exe",
    "gen:bindings": "cd .. && wails3 generate bindings",
    "gen:icon": "cd .. && wails3 generate syso -arch amd64 -icon build/windows/icon.ico -manifest build/windows/wails.exe.manifest -info build/windows/info.json -out toolbox-wails.syso",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@element-plus/icons-vue": "^2.3.2",
    "@lezer/highlight": "^1.2.3",
    "@wailsio/runtime": "3.0.0-beta.20",
    "codemirror": "^6.0.2",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "pinyin-pro": "^3.29.4",
    "sql-formatter": "^15.8.2",
    "vue": "^3.5.0",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@babel/types": "^7.26.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.1.0"
  }
}
